{
  "name": "praman",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Adwaith R Nair",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e/playwright.local.config.ts",
    "e2e:hosted": "playwright test -c e2e/playwright.hosted.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify-ledger": "tsx scripts/verify-ledger.ts",
    "keygen": "tsx scripts/keygen.ts",
    "issue-mandate": "tsx scripts/issue-mandate.ts",
    "seed-catalog": "tsx scripts/seed-catalog.ts",
    "catalog:channel3": "tsx scripts/catalog-channel3.ts",
    "demo": "tsx apps/buyer-agent/src/demo.ts",
    "eval": "tsx apps/eval/src/cli.ts",
    "approve": "tsx scripts/approve.ts",
    "revoke": "tsx scripts/revoke.ts",
    "refund": "tsx scripts/refund.ts",
    "dispute": "tsx scripts/dispute.ts",
    "mcp": "tsx apps/mcp-gateway/src/server.ts",
    "mcp:approve": "tsx apps/mcp-gateway/src/approve.ts",
    "mcp:mandate": "tsx apps/mcp-gateway/src/issue-mandate.ts",
    "pending": "tsx scripts/pending.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "ablation": "tsx apps/eval/src/ablation-cli.ts",
    "receipt-ui": "tsx apps/receipt-ui/src/server.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "eval:check-coverage": "tsx apps/eval/src/check-coverage.ts",
    "lint:boundary": "tsx scripts/check-import-boundary.ts",
    "lint:policy-freeze": "tsx scripts/check-policy-freeze.ts"
  },
  "packageManager": "pnpm@11.24.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@praman/channel3": "workspace:*",
    "@praman/control-plane": "workspace:*",
    "@praman/db": "workspace:*",
    "@praman/dispute": "workspace:*",
    "@praman/exec-core": "workspace:*",
    "@praman/ledger": "workspace:*",
    "@praman/mandate": "workspace:*",
    "@praman/mcp-gateway": "workspace:*",
    "@praman/paypal-exec": "workspace:*",
    "@praman/razorpay-exec": "workspace:*",
    "@praman/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.0"
  }
}
