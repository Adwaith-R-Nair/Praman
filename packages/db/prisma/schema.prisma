generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model LedgerEntry {
  seq         BigInt   @id @default(autoincrement())
  traceId     String   @map("trace_id")
  ts          DateTime @db.Timestamptz(3)
  actor       String
  eventType   String   @map("event_type")
  payload     Json
  payloadHash String   @map("payload_hash") @db.Char(64)
  prevHash    String   @map("prev_hash")    @db.Char(64)
  entryHash   String   @unique @map("entry_hash") @db.Char(64)

  @@index([traceId, seq])
  @@map("ledger_entry")
}

model Mandate {
  mandateId String   @id @map("mandate_id")
  version   Int
  issuerId  String   @map("issuer_id")
  subjectId String   @map("subject_id")
  document  Json
  signature String
  keyId     String   @map("key_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("mandate")
}

model CatalogItem {
  merchantId  String @map("merchant_id")
  sku         String
  title       String
  description String
  category    String
  priceMinor  BigInt @map("price_minor")
  currency    String
  stockQty    Int    @map("stock_qty")

  @@id([merchantId, sku])
  @@map("catalog_item")
}

/// Server-side truth about a merchant. The rail is read from here, never from an intent or a model.
model Merchant {
  merchantId String @id @map("merchant_id")
  rail       String
  currency   String

  @@map("merchant")
}

model IdempotencyRecord {
  key         String   @id @db.Char(64)
  traceId     String   @map("trace_id")
  status      String   @default("pending")
  receipt     String?
  amountMinor BigInt?  @map("amount_minor")
  /// The rail that was called, so a reconciler asks the same one. Set by every writer; there is no default.
  rail        String
  currency    String
  outcome     Json?
  /// "order" or "capture". An order and its capture are separate outbox phases (D-40).
  kind        String   @default("order")
  /// On a capture record: the key of the order it captures. The ledger only ever sees that key.
  orderKey    String?  @map("order_key") @db.Char(64)
  /// On a capture record: the order id a reconcile reads back.
  orderId     String?  @map("order_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("idempotency_record")
}

model Approval {
  approvalId  String    @id @map("approval_id")
  traceId     String    @map("trace_id")
  mandateId   String    @map("mandate_id")
  intent      Json
  amountMinor BigInt    @map("amount_minor")
  currency    String
  status      String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt  DateTime? @map("resolved_at") @db.Timestamptz(3)

  @@map("approval")
}

/// How much of the hosted demo's daily allowance has gone, per UTC day: new sessions
/// and model calls. A counter, not a record: it is not the ledger and holds no money.
/// In the database rather than memory so a restart doesn't hand out a second day's worth.
model DemoUsage {
  day  String
  kind String
  used Int

  @@id([day, kind])
  @@map("demo_usage")
}
