DATABASE_URL=postgresql://postgres:praman@localhost:5432/praman
TEST_DATABASE_URL=postgresql://postgres:praman@localhost:5432/praman_test
# Hosted only. Prisma's CLI (migrations) uses this direct address when set, and the
# server uses DATABASE_URL, which on Neon is the pooled address. Leave empty locally.
DIRECT_DATABASE_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The id of the webhook set up for this app in the PayPal developer dashboard. Unset,
# POST /webhooks/paypal answers 503 and the reconcile sweep is the only settlement path.
PAYPAL_WEBHOOK_ID=
GEMINI_API_KEY=
MANDATE_PRIVATE_KEY=
MANDATE_PUBLIC_KEY=

# Optional — dev observability only, never authorisation. Unset means no
# OpenTelemetry SDK starts and every trace call is a safe no-op (D-47).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# The project id segment from your Langfuse dashboard URL — without it the
# receipt UI still shows a trace id, just not a clickable deep link to it.
LANGFUSE_PROJECT_ID=

# The demo under /demo signs a small USD mandate per visitor session with this key.
# It must be its own key, never MANDATE_PRIVATE_KEY: the demo is off without it.
# Generate with `pnpm keygen` and rename the two names it prints.
DEMO_MANDATE_PRIVATE_KEY=
DEMO_MANDATE_PUBLIC_KEY=
# Where PayPal sends a visitor back to. Defaults to http://localhost:<RECEIPT_UI_PORT>.
# In production it must be the service's https:// address.
DEMO_BASE_URL=
# Model calls per UTC day for every demo visitor together, and new sessions per day.
# Past the model cap, a step replays a recorded model answer, labelled as one.
# Defaults 400 and 200.
DEMO_DAILY_MODEL_CALLS=
DEMO_DAILY_SESSIONS=
# Optional. The switch for the demo's shared sandbox buyer (D-85): the PayPal payment
# token of one sandbox account whose owner approved saving it, from `pnpm house-buyer`.
# Set, a visitor may choose "Use the demo's sandbox buyer" instead of logging in to
# PayPal. Empty, that choice does not exist. It is a secret. A server with it set never
# deletes it at PayPal; a server without it can't know to keep it, so that sandbox
# account should be one nobody else logs in to (docs/DEPLOY.md, step 9). It needs
# PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET of the app that saved it.
DEMO_HOUSE_BUYER_TOKEN=
# Sessions per UTC day that may use that buyer. Default 50. 0 switches it off, and with
# the token above left in place the server still refuses to delete that token at PayPal.
DEMO_DAILY_HOUSE_SESSIONS=
# Optional, and not a secret. The mandate ids of one past demo session, comma-separated
# (a session has two: mnd_demo_<ref> and mnd_demo_<ref>_h). Set, /sample shows that
# session's ledger rows to anyone, read-only, with no budgets and no step-up reasons
# (D-88), and the front page links to it. Empty or malformed, there is no sample page.
SAMPLE_MANDATE_IDS=

# For `pnpm catalog:channel3`, which pins the MCP gateway's products. Sign up for a key
# at https://trychannel3.com. Only that script reads it; nothing at decision time does.
CHANNEL3_API_KEY=

# Optional. Any value other than PayPal's sandbox stops the server at start.
PAYPAL_BASE_URL=
# How many proxies in front of the server append to X-Forwarded-For (Render: 3, D-78), so
# per-address limits see the visitor's address and not one the client wrote. Empty locally.
TRUST_PROXY=
